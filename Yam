import streamlit as st
import yfinance as yf
import pandas as pd
import numpy as np
from sklearn.ensemble import RandomForestClassifier

# Page Configuration
st.set_page_config(page_title="AI Option Trading Assistant", layout="wide")

st.title("📈 AI-Powered Option Trading Assistant (Free Version)")
st.caption("Real-time Technical Analysis & AI Prediction for Index/Stocks")

# Sidebar - User Inputs
st.sidebar.header("User Settings")
ticker = st.sidebar.text_input("Enter Ticker (e.g., ^NSEI for Nifty 50, ^BANKNIFTY for Bank Nifty):", "^NSEI")
period = st.sidebar.selectbox("Data Period:", ["1mo", "3mo", "6mo", "1y"], index=1)
interval = st.sidebar.selectbox("Timeframe:", ["1d", "1h", "15m"], index=0)

@st.cache_data(ttl=300)
def load_data(symbol, p, i):
    data = yf.download(symbol, period=p, interval=i)
    if isinstance(data.columns, pd.MultiIndex):
        data.columns = data.columns.get_level_values(0)
    return data

data = load_data(ticker, period, interval)

if not data.empty:
    # --- Feature Engineering (Indicators) ---
    # Moving Averages
    data['SMA_20'] = data['Close'].rolling(window=20).mean()
    data['SMA_50'] = data['Close'].rolling(window=50).mean()

    # RSI Calculation
    delta = data['Close'].diff()
    gain = (delta.where(delta > 0, 0)).rolling(window=14).mean()
    loss = (-delta.where(delta < 0, 0)).rolling(window=14).mean()
    rs = gain / loss
    data['RSI'] = 100 - (100 / (1 + rs))

    # Target Variable for ML (1 if Next Day Close > Today Close else 0)
    data['Target'] = np.where(data['Close'].shift(-1) > data['Close'], 1, 0)
    
    clean_data = data.dropna().copy()

    # --- ML AI Model Training ---
    features = ['Close', 'SMA_20', 'SMA_50', 'RSI']
    X = clean_data[features]
    y = clean_data['Target']

    # Train Random Forest Model
    model = RandomForestClassifier(n_estimators=100, random_state=42)
    model.fit(X, y)

    # Latest Data for Prediction
    latest_features = clean_data[features].iloc[[-1]]
    prediction = model.predict(latest_features)[0]
    prob = model.predict_proba(latest_features)[0]

    latest_close = float(clean_data['Close'].iloc[-1])
    latest_rsi = float(clean_data['RSI'].iloc[-1])
    latest_sma20 = float(clean_data['SMA_20'].iloc[-1])

    # --- Display Dashboard Metrics ---
    col1, col2, col3, col4 = st.columns(4)
    col1.metric("Current Price", f"₹{latest_close:.2f}")
    col2.metric("RSI (14)", f"{latest_rsi:.2f}")
    col3.metric("SMA 20", f"₹{latest_sma20:.2f}")

    if prediction == 1:
        col4.metric("AI Prediction", "BULLISH 🚀", f"{prob[1]*100:.1f}% Confidence")
    else:
        col4.metric("AI Prediction", "BEARISH 📉", f"{prob[0]*100:.1f}% Confidence", delta_color="inverse")

    st.markdown("---")

    # --- Option Trading Strategy Suggestion ---
    st.subheader("💡 Option Strategy Recommendation")
    if prediction == 1 and latest_rsi < 70:
        st.success("**Bullish View:** Consider Buying Call Option (CE) or Bull Call Spread.")
    elif prediction == 0 and latest_rsi > 30:
        st.error("**Bearish View:** Consider Buying Put Option (PE) or Bear Put Spread.")
    else:
        st.warning("**Neutral/Overbought View:** Market might consolidate or reverse. Avoid aggressive directional buying.")

    # --- Charts ---
    st.subheader("📊 Price Chart & Indicators")
    st.line_chart(clean_data[['Close', 'SMA_20', 'SMA_50']])

else:
    st.error("Data fetch me problem hui. Kripya ticker check karein.")
